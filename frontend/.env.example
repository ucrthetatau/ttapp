# Copy this file to .env.local and fill in the values. Never commit .env.local.
# Vite only passes variables that start with VITE_ to the browser, and everything in them is
# public, so only put values here that are safe for anyone to see.

# The "doorbell" (Supabase Realtime): tells the feed page when someone posts. Optional: leave
# both empty and the feed still works, it just won't update by itself.
# Same values as SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY in backend/.env.example.
# Use the dev project locally.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
